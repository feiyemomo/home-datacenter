# ---- Runtime data / secrets (never commit) ----
# SQLite database + mosquitto persistence hold live state and (in the
# DB's case) AccessKey hashes + user identities.
/data/
/.env
.env.local

# Local config override holds the real jwt.secret; never commit it.
services/api/configs/config.local.yaml

# ---- Deploy secrets — never commit ----
# Anyone cloning the repo must create these manually (see docs/security.md).
deploy/cloudflared/credentials.json
deploy/mosquitto/passwd
deploy/frigate/config.yml

# ---- IDE / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Go ----
services/api/server
services/api/cmd.exe
services/api/*.exe
*.test
*.out

# ---- Node / web ----
web/node_modules/
web/dist/
web/.npm-cache/
web/.npm-prefix/
web/tsconfig.tsbuildinfo
web/tsconfig.node.tsbuildinfo

# ---- Build artifacts & iteration leftovers ----
# Old go2rtc build artifacts (no longer used — Frigate is a prebuilt
# image). Kept in .gitignore so stale local dirs don't get tracked.
go2rtc-extract/
go2rtc-new/
go2rtc-v2/
go2rtc-*.tar
go2rtc-newly-built

# Ad-hoc token / offer files
.token.txt
sdp_offer.txt

# Vision models (downloaded via download_models.py)
services/vision/models/*.onnx

# Ad-hoc build logs. Generated as `build_*.log`.
build_*.log

# Live JWT for ad-hoc curl tests. NEVER commit — rotate immediately
# if this file leaks (see docs/security.md).
.token.txt

# ---- Android / Gradle ----
android/.gradle/
android/.kotlin/
android/local.properties
android/*.log
android/app/build/
android/build/
# Versioned APK binaries live on the NAS (data/releases), not in git.
android/app-debug-*.apk
android/app-release-*.apk
# Release notes are publish artifacts (scp'd to NAS), not tracked in git.
android/release-notes-v*.txt

# web sync tarball used by scp-based deploys
web-sync.tar.gz

# Local notes / specs / prompts (contain private IP & credentials)
PROMPT.md
.trae/

# Ad-hoc debug / local testing scripts & SQL
check_logs.sql
cleanup_logs.sql
read_db.py
scan2.sh
scan3.sh
scan-camera.sh
db-cam.sh
db-cam2.sh
check-arp.sh
check-cam-route.sh
check-interfaces.sh
check-ipv6-listen.sh
check-ipv6.sh
check-cam.sh
check-api.sh
diag-ipv6-docker.sh
diag-ipv6-route.sh
fix-cam-alias.sh
fix-dns-and-deploy.sh
fix-eno1-ipv6.sh
fix-routing.sh
build-host/

# Build logs & compiled binaries
*.log
build.log*
services/api/bin/
