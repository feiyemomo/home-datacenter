# Home Datacenter — environment variables example
#
# Copy to .env and adjust values. docker compose automatically loads
# a .env file in the same directory. The .env file is gitignored —
# never commit it.

# ---- API service ----
# Override the config file path (default: configs/config.yaml)
APP_CONFIG=/configs/config.yaml

# ---- JWT signing secret (REQUIRED) ----
# The API refuses to start without a 32+ char secret. Generate with:
#   openssl rand -hex 32
# This overrides jwt.secret in configs/config.yaml.
JWT_SECRET=your-secret-key

# ---- MQTT broker auth ----
# The API server authenticates to Mosquitto with this username/password.
# allow_anonymous=false in deploy/mosquitto/mosquitto.conf, so these
# MUST be set. The matching password entry must exist in
# deploy/mosquitto/passwd (create with mosquitto_passwd).
MQTT_BROKER=tcp://mosquitto:1883
MQTT_CLIENT_ID=home-datacenter
MQTT_USERNAME=home-datacenter
MQTT_PASSWORD=
MQTT_QOS=1

# ---- WebSocket ----
WS_PATH=/api/v1/ws
WS_HEARTBEAT_SECONDS=30

# ---- Database ----
DB_PATH=/data/sqlite/app.db

# ---- Server ----
SERVER_PORT=8080

# ---- Local dev: host port to expose Mosquitto on (optional) ----
# Only used if you uncomment the mosquitto ports mapping in compose.yaml.
# MQTT_BIND_PORT=1883

# ---- Frigate / go2rtc (Phase 4: camera platformization) ----
# Frigate bundles go2rtc internally. home-api pushes stream definitions
# to the bundled go2rtc on port 1984 and camera config to the Frigate
# REST API on port 5000. Defaults are reachable from inside the Docker
# network. Override only if Frigate runs on a different host.
GO2RTC_BASE_URL=http://home-frigate:1984
FRIGATE_BASE_URL=http://home-frigate:5000

# ---- Network: NAS IP configuration ----
# NAS_LAN_IP: the host's physical LAN IPv4 address (e.g. 192.168.31.235).
# Used by SetWebRTCCandidates() to build go2rtc's webrtc.candidates list.
# Without this, WebRTC is unreachable from LAN clients. Update when the
# NAS IP changes.
NAS_LAN_IP=192.168.31.235

# NAS_IPV6_ADDRESS: the host's public IPv6 address (SLAAC EUI-64).
# The container cannot probe IPv6 on the Docker bridge, so we trust this
# value. Update if the ISP rotates the IPv6 prefix.
# NAS_IPV6_ADDRESS=2409:8a70:37ad:6870:62be:b4ff:fe08:bd09

# NAS_IPV6_DISABLED: set to "true" in offline LAN environments (no Internet)
# to disable IPv6 reporting. This prevents the mobile app from wasting
# time on IPv6 direct mode that can never succeed.
# NAS_IPV6_DISABLED=false

# ---- 亿安云 (Bitiful) 异地备份 (v1.8.29) ----
# S3-compatible object storage used by the backup container to push a
# copy of the daily SQLite snapshots (data/sqlite/backups/) off-NAS, so
# a NAS disk failure doesn't lose the DB. Free tier: 50GB storage.
# Create a private bucket in the Bitiful console, then generate a
# sub-user AccessKey/SecretKey and grant it read-write on that bucket.
# Leave BITIFUL_ACCESS_KEY empty to disable the backup container.
BITIFUL_ENDPOINT=https://s3.bitiful.net
BITIFUL_REGION=cn-east-1
BITIFUL_BUCKET=nas-data
BITIFUL_ACCESS_KEY=
BITIFUL_SECRET_KEY=
# Local SQLite backup dir to sync (default: the maintenance backups).
BITIFUL_SOURCE_DIR=./data/sqlite/backups
# How often to sync (seconds). Default 6h = 21600; 24h = 86400.
BITIFUL_SYNC_INTERVAL=21600

# ---- H3C 简优云 NAT 穿透保活 (v1.8.36) ----
# 自动化循环保活 H3C 路由器 3 小时限制的内网穿透
H3C_USERNAME=momo324
H3C_PASSWORD=
H3C_APP_NAME=home

